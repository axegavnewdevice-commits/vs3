{
  "version": 2,
  "builds": [
    { "src": "rooms.js", "use": "@vercel/node" },
    { "src": "action.js", "use": "@vercel/node", "config": { "includeFiles": ["words.bin", "wordcheck.js"] } },
    { "src": "cleanup.js", "use": "@vercel/node" },
    { "src": "config.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "pwa-check.html", "use": "@vercel/static" },
    { "src": "icon-maker.html", "use": "@vercel/static" },
    { "src": "multiplayer.js", "use": "@vercel/static" },
    { "src": "multiplayer.css", "use": "@vercel/static" },
    { "src": "wordcheck.js", "use": "@vercel/static" },
    { "src": "words.bin", "use": "@vercel/static" },
    { "src": "sw.js", "use": "@vercel/static" },
    { "src": "manifest.webmanifest", "use": "@vercel/static" },
    { "src": "favicon.ico", "use": "@vercel/static" },
    { "src": "icon.svg", "use": "@vercel/static" },
    { "src": "*.png", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/sw.js", "headers": { "Cache-Control": "public, max-age=0, must-revalidate", "Service-Worker-Allowed": "/" }, "continue": true },
    { "src": "/manifest.webmanifest", "headers": { "Content-Type": "application/manifest+json; charset=utf-8", "Cache-Control": "public, max-age=0, must-revalidate" }, "continue": true },
    { "src": "/api/rooms", "dest": "/rooms.js" },
    { "src": "/api/action", "dest": "/action.js" },
    { "src": "/api/cleanup", "dest": "/cleanup.js" },
    { "src": "/api/config", "dest": "/config.js" },
    { "src": "/icons/(.*)", "dest": "/$1" },
    { "handle": "filesystem" }
  ],
  "crons": [{ "path": "/api/cleanup", "schedule": "0 3 * * *" }]
}
